{# Blog shared-section renderers — Step 1 prototype. #}
{% macro sourcesPanel(heading, items, sectionClass) %}<!-- Sources & References -->
 <section class="{{ sectionClass or 'max-w-4xl mx-auto px-6 mb-16' }}">
 <h2 class="text-lg font-black text-brandBlue uppercase italic mb-4">{{ heading | safe }}</h2>
 <ul class="text-sm text-slate-600 space-y-2 list-disc pl-5">
{% for it in items %} <li><a href="{{ it.href }}" target="_blank" rel="{{ it.rel }}" class="{{ it.cls }}">{{ it.text | safe }}</a></li>
{% endfor %} </ul>
 </section>{% endmacro %}
