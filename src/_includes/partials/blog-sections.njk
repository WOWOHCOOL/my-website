{# Blog shared-section renderers — Step 1 prototype. #}
{% macro sourcesPanel(heading, items, sectionClass) %}<!-- Sources & References -->
 <section class="{{ sectionClass or 'max-w-4xl mx-auto px-6 mb-16' }}">
 <h2 class="text-lg font-black text-brandBlue uppercase italic mb-4">{{ heading | safe }}</h2>
 <ul class="text-sm text-slate-600 space-y-2 list-disc pl-5">
{% for it in items %} <li{% if it.liClass %} class="{{ it.liClass }}"{% endif %}><a href="{{ it.href }}" target="_blank" rel="{{ it.rel }}" class="{{ it.cls }}">{{ it.text | safe }}</a>{{ it.after | safe }}</li>
{% endfor %} </ul>
 </section>{% endmacro %}

{# ---- Featured Image (panel 3) ---- #}
{% macro featuredImage(imgSrc, srcset, sizes, alt, title, width, height) %}<!-- Featured Image -->
 <div class="max-w-4xl mx-auto px-6 mb-16">
 <img src="{{ imgSrc }}" srcset="{{ srcset }}" sizes="{{ sizes }}"
 alt="{{ alt }}"
{% if title %} title="{{ title }}"
{% endif %} width="{{ width }}"
 height="{{ height }}"
 loading="eager"
 decoding="async"
 class="w-full rounded-3xl shadow-xl"
 fetchpriority="high">
 </div>{% endmacro %}

{# ---- CTA (panel 12). cardInner=true → gradient on inner div (standard §12); wrapClass → outer container ---- #}
{% macro ctaPanel(heading, subtext, primaryHref, primaryLabel, secondaryHref, secondaryLabel, wrapClass, cardInner, sectionClass, cardClass, primaryClass, secondaryClass, subtextClass) %}<!-- CTA -->
{% if wrapClass %} <div class="{{ wrapClass }}">
{% endif %}{% if cardInner %} <section class="{{ sectionClass or 'max-w-4xl mx-auto px-6 mb-16' }}">
 <div class="{{ cardClass or 'relative bg-gradient-to-br from-brandBlue to-slate-800 rounded-3xl p-10 text-center overflow-hidden' }}">
{% else %} <section class="{{ cardClass or 'relative bg-gradient-to-br from-brandBlue to-slate-800 rounded-3xl p-10 text-center mb-16 overflow-hidden' }}">
{% endif %} <div class="absolute top-0 right-0 w-64 h-64 bg-brandOrange/20 rounded-full blur-3xl"></div>
 <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl"></div>
 <div class="relative z-10">
 <h2 class="text-2xl font-black text-white uppercase italic mb-4">{{ heading | safe }}</h2>
 <p class="{{ subtextClass or 'text-slate-300 mb-8 max-w-xl mx-auto' }}">{{ subtext | safe }}</p>
 <div class="flex flex-col sm:flex-row gap-4 justify-center">
 <a href="{{ primaryHref }}" class="{{ primaryClass or 'btn-wide' }}">{{ primaryLabel | safe }}</a>
 <a href="{{ secondaryHref }}" class="{{ secondaryClass or 'w-full sm:flex-1 text-center border-2 border-white text-white px-8 py-4 rounded-xl font-black uppercase text-sm hover:bg-white hover:text-brandBlue transition' }}">{{ secondaryLabel | safe }}</a>
 </div>
 </div>
{% if cardInner %} </div>
{% endif %}</section>{% if wrapClass %}
 </div>{% endif %}{% endmacro %}

{# ---- Related Articles (panel 13) ---- #}
{% macro relatedPanel(heading, cards, asideClass, h2Class, headingBar) %}<aside id="related-articles" class="{{ asideClass or 'max-w-4xl mx-auto mb-16' }}">
{% if headingBar %} <div class="flex items-center gap-3 mb-6">
 <div class="w-1 h-6 bg-brandOrange rounded-full"></div>
 <h2 class="{{ h2Class or 'text-lg font-black text-brandBlue uppercase italic' }}">{{ heading | safe }}</h2>
 </div>
{% else %} <h2 class="{{ h2Class or 'text-2xl font-black text-brandBlue uppercase italic mb-6' }}">{{ heading | safe }}</h2>
{% endif %}
 <div class="grid md:grid-cols-3 gap-4">
{% for c in cards %} <a href="{{ c.href }}" class="bg-slate-50 rounded-xl overflow-hidden hover:shadow-xl transition group">
 <div class="h-2 bg-gradient-to-r {{ c.gradient }}"></div>
 <div class="{{ c.contentClass or 'p-6' }}">
{% if c.tag %} <span class="text-xs font-black text-brandOrange uppercase mb-2 block">{{ c.tag | safe }}</span>
{% endif %} <h3 class="font-black text-brandBlue uppercase text-sm mb-1 group-hover:text-brandOrange transition">{{ c.title | safe }}</h3>
 <p class="text-slate-600 {{ c.descClass or 'text-sm' }}">{{ c.desc | safe }}</p>
 </div>
 </a>
{% endfor %} </div>
</aside>{% endmacro %}

{# ---- Hook (panel 2) ---- #}
{% macro hookPanel(para1, para2, wrapClass) %}<!-- The Hook -->
{% if wrapClass %} <div class="{{ wrapClass }}">
{% endif %} <div class="bg-brandBlue/5 border-l-4 border-brandOrange p-6 rounded-r-xl mb-8 speakable">
 <p class="text-lg text-slate-700 italic">{{ para1 | safe }}</p>
{% if para2 %} <p class="text-slate-600 leading-relaxed mt-4">{{ para2 | safe }}</p>
{% endif %} </div>{% if wrapClass %}
 </div>{% endif %}{% endmacro %}

{# ---- Key Takeaways (panel 4) ---- #}
{% macro takeawaysPanel(label, tldr, items) %}<div class="bg-amber-50 border-l-4 border-amber-500 rounded-r-xl p-6 mb-8">
 <p class="text-badge font-black text-brandOrange uppercase tracking-widest mb-2">{{ label | safe }}</p>
 <p class="text-slate-700 leading-relaxed text-sm mb-4 speakable">{{ tldr | safe }}</p>
 <ul class="text-sm text-slate-700 space-y-2 list-disc pl-5">
{% for it in items %} <li>{{ it | safe }}</li>
{% endfor %} </ul>
 </div>{% endmacro %}

{# ---- Table of Contents (panel 6) ---- #}
{% macro tocPanel(heading, items, h2Class, wrapClass) %}<!-- Table of Contents -->
{% if wrapClass %} <div class="{{ wrapClass }}">
{% endif %} <div class="bg-brandBlue rounded-2xl p-8 text-white mb-12">
 <h2 class="{{ h2Class or 'text-lg font-black uppercase italic mb-6' }}">{{ heading | safe }}</h2>
 <nav class="text-sm space-y-2">
{% for it in items %} <a href="{{ it.href }}" class="block hover:text-brandOrange transition">{{ it.text | safe }}</a>
{% endfor %} </nav>
 </div>{% if wrapClass %}
 </div>{% endif %}{% endmacro %}

{# ---- Key Metrics Cards (panel 5, optional) ---- #}
{% macro metricsPanel(items) %}<div class="mb-12">
 <div class="grid grid-cols-2 md:grid-cols-{{ items.length if items.length > 3 else items.length }} gap-3">
{% for it in items %} <div class="{{ it.cardClass or 'bg-white rounded-xl p-4 border border-slate-200 text-center shadow-sm' }}">
 <div class="text-2xl font-black {{ it.colorClass or 'text-brandBlue' }} mb-1">{{ it.val }}</div>
 <div class="text-micro text-slate-500 uppercase tracking-wider leading-tight">{{ it.label | safe }}</div>
 </div>
{% endfor %} </div>
 </div>{% endmacro %}

{# ---- FAQ (panel 10). layout=card (default) | details. wrapClass e.g. 'max-w-4xl mx-auto px-6' ---- #}
{% macro faqPanel(heading, items, layout, wrapClass) %}<section id="faq" class="mb-16">
{% if wrapClass %} <div class="{{ wrapClass }}">
{% endif %} <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200 shadow-sm">
 <h2 class="text-2xl font-black text-brandBlue uppercase italic mb-8 text-center">{{ heading | safe }}</h2>
 <div class="space-y-6 max-w-3xl mx-auto">
{% for it in items %}{% if layout == 'details' %}<details class="faq-item">
<summary>{{ it.q | safe }}</summary>
<div class="faq-answer">{{ it.a | safe }}</div>
</details>{% else %}<div class="bg-white rounded-xl p-6 faq-answer">
<h3 class="font-black text-brandBlue mb-2">{{ it.q | safe }}</h3>
<p class="text-slate-600 text-sm">{{ it.a | safe }}</p>
</div>{% endif %}
{% endfor %} </div>
 </div>
{% if wrapClass %} </div>
{% endif %}</section>{% endmacro %}

{# ---- Conclusion (panel 9, optional). list = { class?, items:[...] } | null ---- #}
{% macro conclusionPanel(heading, paragraphs, list, paragraphsAfter, sectionClass) %}<section id="conclusion" class="{{ sectionClass or 'max-w-4xl mx-auto px-6 mb-16' }}">
 <div class="bg-slate-50 rounded-xl p-6 border border-slate-200 shadow-sm">
 <h2 class="text-2xl font-black text-brandBlue uppercase italic mb-6">{{ heading | safe }}</h2>
{% for p in paragraphs %} <p class="text-slate-600 leading-relaxed mb-4">{{ p | safe }}</p>
{% endfor %}{% if list and list.items and list.items.length %} <ol class="{{ list.class or 'list-decimal pl-5 space-y-2 text-slate-600 text-sm' }}">
{% for it in list.items %} <li{% if it.cls %} class="{{ it.cls }}"{% endif %}>{{ it.html | safe }}</li>
{% endfor %} </ol>
{% endif %}{% for p in paragraphsAfter %} <p class="text-slate-600 leading-relaxed mb-4">{{ p | safe }}</p>
{% endfor %} </div>
</section>{% endmacro %}

{# ---- Full Author Bio (panel 11) ---- #}
{% macro authorBioPanel(a) %}<section id="author-bio" class="{{ a.sectionClass or 'max-w-4xl mx-auto px-6' }}">
<div class="{{ a.innerClass or 'bg-slate-50 rounded-2xl p-6 md:p-8 mb-12 border border-slate-100' }}">
 <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6">
 <div class="w-20 h-20 rounded-full overflow-hidden flex items-center justify-center border-2 border-brandOrange bg-white shadow-lg shrink-0">
 <img src="{{ a.avatar }}"{{ a.avatarSrcset | safe }} sizes="{{ a.avatarSizes | safe }}" alt="{{ a.avatarAlt | safe }}" loading="lazy" width="{{ a.avatarW }}" height="{{ a.avatarH }}" class="w-full h-full object-cover" decoding="async">
 </div>
 <div class="flex-1 min-w-0">
 <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 mb-2 sm:mb-3">
 <a href="{{ a.linkedin }}" target="_blank" rel="noopener noreferrer" class="font-black text-slate-900 text-lg hover:text-brandOrange transition">{{ a.name | safe }}</a>
 <span class="px-2 py-1 bg-brandOrange/10 text-brandOrange text-badge font-black rounded-full uppercase w-fit">{{ a.badge | safe }}</span>
 </div>
 <p class="text-sm text-slate-500 mb-3">{{ a.role | safe }}</p>
 <p class="text-slate-600 text-sm leading-relaxed">{{ a.bio | safe }}</p>
        <p class="text-sm mb-3"><a href="{{ a.profileHref }}"{% if a.profileHreflang %} hreflang="{{ a.profileHreflang }}"{% endif %} class="text-brandBlue hover:text-brandOrange font-bold">{{ a.profileLabel | safe }}</a></p>
<div class="mt-4 pt-4 border-t border-slate-200">
 <p class="text-xs text-slate-400 uppercase tracking-wider mb-2">{{ a.footprintLabel | safe }}</p>
 <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
{% for it in a.footprint %} <div><span class="font-black text-brandBlue">{{ it.val | safe }}</span><p class="text-xs text-slate-500">{{ it.label | safe }}</p></div>
{% endfor %} </div>
 </div>
 </div>
 </div>
 </div>
</section>{% endmacro %}

{# ---- Buyer Specification Card (panel 9.5, optional) ---- #}
{% macro buyerSpecPanel(heading, cards, sectionClass) %}<section class="{{ sectionClass or 'max-w-4xl mx-auto px-6 mb-16' }}">
 <h2 class="text-2xl font-black text-brandBlue uppercase italic mb-6">{{ heading | safe }}</h2>
 <div class="grid md:grid-cols-3 gap-4">
{% for c in cards %}   <div class="bg-slate-50 rounded-xl p-5 border border-slate-200">
     <p class="text-xs font-black text-brandOrange uppercase tracking-wider mb-2">{{ c.label | safe }}</p>
     <ul class="text-sm text-slate-600 space-y-1 list-disc pl-4">
{% for it in c.items %}       <li>{{ it | safe }}</li>
{% endfor %}     </ul>
   </div>
{% endfor %} </div>
</section>{% endmacro %}
