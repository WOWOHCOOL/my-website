{# Blog shared-section renderers — Step 1 prototype. #}
{% macro sourcesPanel(heading, items, sectionClass) %}<!-- Sources & References -->
 <section class="{{ sectionClass or 'max-w-4xl mx-auto px-6 mb-16' }}">
 <h2 class="text-lg font-black text-brandBlue uppercase italic mb-4">{{ heading | safe }}</h2>
 <ul class="text-sm text-slate-600 space-y-2 list-disc pl-5">
{% for it in items %} <li><a href="{{ it.href }}" target="_blank" rel="{{ it.rel }}" class="{{ it.cls }}">{{ it.text | safe }}</a></li>
{% endfor %} </ul>
 </section>{% endmacro %}

{# ---- Featured Image (panel 3) ---- #}
{% macro featuredImage(imgSrc, srcset, sizes, alt, title, width, height) %}<!-- Featured Image -->
 <div class="max-w-4xl mx-auto px-6 mb-16">
 <img src="{{ imgSrc }}" srcset="{{ srcset }}" sizes="{{ sizes }}"
 alt="{{ alt }}"
 title="{{ title }}"
 width="{{ width }}"
 height="{{ height }}"
 loading="eager"
 decoding="async"
 class="w-full rounded-3xl shadow-xl"
 fetchpriority="high">
 </div>{% endmacro %}

{# ---- CTA (panel 12) ---- #}
{% macro ctaPanel(heading, subtext, primaryHref, primaryLabel, secondaryHref, secondaryLabel) %}<!-- CTA -->

<section class="relative bg-gradient-to-br from-brandBlue to-slate-800 rounded-3xl p-10 text-center mb-16 overflow-hidden">
 <div class="absolute top-0 right-0 w-64 h-64 bg-brandOrange/20 rounded-full blur-3xl"></div>
 <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl"></div>
 <div class="relative z-10">
 <h2 class="text-2xl font-black text-white uppercase italic mb-4">{{ heading | safe }}</h2>
 <p class="text-slate-300 mb-8 max-w-xl mx-auto">{{ subtext | safe }}</p>
 <div class="flex flex-col sm:flex-row gap-4 justify-center">
 <a href="{{ primaryHref }}" class="btn-wide">{{ primaryLabel }}</a>
 <a href="{{ secondaryHref }}" class="w-full sm:flex-1 text-center border-2 border-white text-white px-8 py-4 rounded-xl font-black uppercase text-sm hover:bg-white hover:text-brandBlue transition">{{ secondaryLabel }}</a>
 </div>
 </div>
 </section>{% endmacro %}

{# ---- Related Articles (panel 13) ---- #}
{% macro relatedPanel(heading, cards, asideClass) %}<aside id="related-articles" class="{{ asideClass or 'max-w-4xl mx-auto mb-16' }}">
 <h2 class="text-2xl font-black text-brandBlue uppercase italic mb-6">{{ heading | safe }}</h2>
 <div class="grid md:grid-cols-3 gap-4">
{% for c in cards %} <a href="{{ c.href }}" class="bg-slate-50 rounded-xl overflow-hidden hover:shadow-xl transition group">
 <div class="h-2 bg-gradient-to-r {{ c.gradient }}"></div>
 <div class="p-6">
 <span class="text-xs font-black text-brandOrange uppercase mb-2 block">{{ c.tag }}</span>
 <h3 class="font-black text-brandBlue uppercase text-sm mb-1 group-hover:text-brandOrange transition">{{ c.title }}</h3>
 <p class="text-slate-600 text-sm">{{ c.desc }}</p>
 </div>
 </a>
{% endfor %} </div>
</aside>{% endmacro %}

{# ---- Hook (panel 2) ---- #}
{% macro hookPanel(para1, para2) %}<!-- The Hook -->
 <div class="bg-brandBlue/5 border-l-4 border-brandOrange p-6 rounded-r-xl mb-8 speakable">
 <p class="text-lg text-slate-700 italic">{{ para1 | safe }}</p>
{% if para2 %} <p class="text-slate-600 leading-relaxed mt-4">{{ para2 | safe }}</p>
{% endif %} </div>{% endmacro %}

{# ---- Key Takeaways (panel 4) ---- #}
{% macro takeawaysPanel(label, tldr, items) %}<div class="bg-amber-50 border-l-4 border-amber-500 rounded-r-xl p-6 mb-8">
 <p class="text-badge font-black text-brandOrange uppercase tracking-widest mb-2">{{ label | safe }}</p>
 <p class="text-slate-700 leading-relaxed text-sm mb-4 speakable">{{ tldr | safe }}</p>
 <ul class="text-sm text-slate-700 space-y-2 list-disc pl-5">
{% for it in items %} <li>{{ it | safe }}</li>
{% endfor %} </ul>
 </div>{% endmacro %}

{# ---- Table of Contents (panel 6) ---- #}
{% macro tocPanel(heading, items, h2Class) %}<!-- Table of Contents -->
 <div class="bg-brandBlue rounded-2xl p-8 text-white mb-12">
 <h2 class="{{ h2Class or 'text-lg font-black uppercase italic mb-6' }}">{{ heading | safe }}</h2>
 <nav class="text-sm space-y-2">
{% for it in items %} <a href="{{ it.href }}" class="block hover:text-brandOrange transition">{{ it.text | safe }}</a>
{% endfor %} </nav>
 </div>{% endmacro %}

{# ---- Key Metrics Cards (panel 5, optional) ---- #}
{% macro metricsPanel(items) %}<div class="mb-12">
 <div class="grid grid-cols-2 md:grid-cols-{{ items.length if items.length > 3 else items.length }} gap-3">
{% for it in items %} <div class="{{ it.cardClass or 'bg-white rounded-xl p-4 border border-slate-200 text-center shadow-sm' }}">
 <div class="text-2xl font-black {{ it.colorClass or 'text-brandBlue' }} mb-1">{{ it.val }}</div>
 <div class="text-micro text-slate-500 uppercase tracking-wider leading-tight">{{ it.label | safe }}</div>
 </div>
{% endfor %} </div>
 </div>{% endmacro %}

{# ---- FAQ (panel 10). layout=card (default) | details ---- #}
{% macro faqPanel(heading, items, layout) %}<section id="faq" class="mb-16">
 <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200 shadow-sm">
 <h2 class="text-2xl font-black text-brandBlue uppercase italic mb-8 text-center">{{ heading | safe }}</h2>
 <div class="space-y-6 max-w-3xl mx-auto">
{% for it in items %}{% if layout == 'details' %}<details class="faq-item">
<summary>{{ it.q | safe }}</summary>
<div class="faq-answer">{{ it.a | safe }}</div>
</details>{% else %}<div class="bg-white rounded-xl p-6 faq-answer">
<h3 class="font-black text-brandBlue mb-2">{{ it.q | safe }}</h3>
<p class="text-slate-600 text-sm">{{ it.a | safe }}</p>
</div>{% endif %}
{% endfor %} </div>
 </div>
</section>{% endmacro %}
