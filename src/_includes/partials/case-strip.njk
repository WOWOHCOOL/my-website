{#
  Compact selected-cases strip for EN product subpages that lack a case module.
  Uses the verified cases already published on /case-studies/.
  Usage: {% include "partials/case-strip.njk" %}
#}
{% from "partials/section-header.njk" import sectionHeader with context %}
<section id="selected-cases" class="sec bg-white" data-section="content">
 <div class="container-wide">
  {{ sectionHeader('Case Studies', 'Selected <span class="text-brandOrange">Cooperation Cases</span>', 'Three programmes across the UK, Germany and Denmark. Full case studies cover the brief, the challenge and the delivery data.', {max: '', mb: 'mb-12'}) }}
  <div class="grid md:grid-cols-3 gap-6">
   <article class="card-lg-soft bg-white p-6 reveal">
    <p class="text-badge font-bold uppercase tracking-widest text-brandOrangeDeep mb-2">UK · Premium Lifestyle Tech</p>
    <h3 class="text-lg font-black text-brandBlue uppercase italic mb-3">Mous</h3>
    <p class="text-sm text-slate-600 leading-relaxed">50,000+ MagSafe-compatible wireless chargers since 2023, across recurring purchase cycles.</p>
   </article>
   <article class="card-lg-soft bg-white p-6 reveal">
    <p class="text-badge font-bold uppercase tracking-widest text-brandOrangeDeep mb-2">Germany · Automotive</p>
    <h3 class="text-lg font-black text-brandBlue uppercase italic mb-3">Bosch</h3>
    <p class="text-sm text-slate-600 leading-relaxed">10,000 × 65W GaN car chargers delivered on an emergency timeline, with 5-day samples.</p>
   </article>
   <article class="card-lg-soft bg-white p-6 reveal">
    <p class="text-badge font-bold uppercase tracking-widest text-brandOrangeDeep mb-2">Denmark · Design House</p>
    <h3 class="text-lg font-black text-brandBlue uppercase italic mb-3">Jacob Jensen</h3>
    <p class="text-sm text-slate-600 leading-relaxed">6,000 wireless car mounts with infrared and touch dual-sensing, delivered with zero defects.</p>
   </article>
  </div>
  <div class="text-center mt-10">
   <a href="/case-studies/" class="btn-more">View all case studies <span>&rarr;</span></a>
  </div>
 </div>
</section>
