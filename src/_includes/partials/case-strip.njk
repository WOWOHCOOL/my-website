{#
  Compact selected-cases strip for EN product subpages that lack a case module.
  Uses the verified cases already published on /case-studies/.
  Usage: {% include "partials/case-strip.njk" %}
#}
{% from "partials/section-header.njk" import sectionHeader with context %}
{%- set L = lang or 'en' -%}
{%- set t = (productPageI18n[L] or productPageI18n.en).caseStrip -%}
{%- set casesBg = casesBg or 'bg-white' -%}
<section id="selected-cases" class="sec {{ casesBg }}" data-section="content">
 <div class="container-wide">
  {{ sectionHeader(t.label, t.title, t.desc, {max: '', mb: 'mb-12'}) }}
  <div class="grid md:grid-cols-3 gap-6">
   {%- for c in t.cases %}
   <article class="card-lg-soft bg-white p-6 reveal">
    <p class="text-badge font-bold uppercase tracking-widest text-brandOrangeDeep mb-2">{{ c.region }}</p>
    <h3 class="text-lg font-black text-brandBlue uppercase italic mb-3">{{ c.name }}</h3>
    <p class="text-sm text-slate-600 leading-relaxed">{{ c.desc }}</p>
   </article>
   {%- endfor %}
  </div>
  <div class="text-center mt-10">
   <a href="{{ t.ctaUrl }}" class="btn-more">{{ t.cta }} <span>&rarr;</span></a>
  </div>
 </div>
</section>
