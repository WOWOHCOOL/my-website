{#
  Model comparison table for EN product subpages.
  Usage:
    {% set compareFamily = family %}
    {% include "partials/model-compare.njk" %}
  Columns come from src/_data/modelCompare.js; rows come from src/_products/*.json
  via productModels (rows = [label, value, propertyID]). Families with multiple
  groups (e.g. car-charger main + mini) render a group separator row.
#}
{% from "partials/section-header.njk" import sectionHeader with context %}
{%- set L = lang or 'en' -%}
{%- set cfg = modelCompare[compareFamily] -%}
{%- set fam = productModels[L][compareFamily] -%}
{%- if cfg and fam and fam.groups and fam.groups.length -%}
{%- set total = fam | modelTotal -%}
<section id="model-comparison" class="sec bg-slate-50" data-section="content">
 <div class="container-wide">
  {{ sectionHeader('Specifications', 'Compare All <span class="text-brandOrange">' ~ total ~ ' Models</span>', 'Key specifications side by side. Certification, MOQ and lead-time notes follow the table.', {max: '', mb: 'mb-12'}) }}
  <div class="overflow-x-auto reveal rounded-xl border border-slate-200 bg-white shadow-sm">
   <table class="w-full min-w-[760px] text-sm border-collapse spec-table">
    <caption class="sr-only">Model comparison: key specifications for all models in this product line</caption>
    <thead>
     <tr class="bg-brandBlue text-white text-left">
      <th scope="col" class="p-4 font-black">Model</th>
      {%- for col in cfg.columns %}
      <th scope="col" class="p-4 font-black">{{ col.label }}</th>
      {%- endfor %}
     </tr>
    </thead>
    <tbody>
     {%- for group in fam.groups %}
     {%- if fam.groups.length > 1 %}
     <tr class="bg-slate-100 border-b border-slate-200">
      <td colspan="{{ 1 + cfg.columns.length }}" class="p-3 text-xs font-black uppercase tracking-wider text-brandBlue">{{ group.h2 or group.sectionId }}</td>
     </tr>
     {%- endif %}
     {%- for m in group.models %}
     <tr class="border-b border-slate-100 align-top{% if loop.index is even %} bg-slate-50{% endif %}">
      <td class="p-4"><a href="#{{ m.anchor }}" class="font-bold text-brandBlue hover:text-brandOrange transition" title="{{ m.name }}">{{ m.sku }}<span class="sr-only"> — {{ m.name }}</span></a></td>
      {%- for col in cfg.columns %}
      {%- set val = m.rows | specValue(col) %}
      <td class="p-4 text-slate-600">{{ val or '—' }}</td>
      {%- endfor %}
     </tr>
     {%- endfor %}
     {%- endfor %}
    </tbody>
   </table>
  </div>
  <p class="text-xs text-slate-400 mt-4 text-center">{{ cfg.note }}</p>
 </div>
</section>
{%- endif -%}
