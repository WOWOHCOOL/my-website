{# Shared CTA button. Usage:
   {% from "partials/cta-button.njk" import ctaButton with context %}
   {{ ctaButton("factoryPricing", "primary", "open-modal", "Product OEM/ODM") }}
#}
{% macro ctaButton(intent, level, action, product, href, label, extraClass, showArrow) %}
{%- set currentLang = lang or "en" -%}
{%- set resolvedIntent = intent or "factoryPricing" -%}
{%- set resolvedLevel = level or "primary" -%}
{%- set intentLabels = ctaLabels[resolvedIntent] if ctaLabels and ctaLabels[resolvedIntent] else null -%}
{%- set resolvedLabel = label or (intentLabels[currentLang] if intentLabels and intentLabels[currentLang] else (intentLabels.en if intentLabels else resolvedIntent)) -%}
{%- set baseClass = "btn-cta-" + resolvedLevel -%}
{%- set finalClass = baseClass + ((" " + extraClass) if extraClass else "") -%}
{%- if href -%}
<a href="{{ href }}" class="{{ finalClass }}"{% if action %} data-action="{{ action }}"{% endif %}{% if product %} data-product="{{ product }}"{% endif %}>{{ resolvedLabel }}{% if showArrow !== false %} <svg class="icon-arrow-right" aria-hidden="true" focusable="false" viewBox="0 0 512 512"><path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z" fill="currentColor"/></svg>{% endif %}</a>
{%- else -%}
<button type="button" class="{{ finalClass }} cursor-pointer"{% if action %} data-action="{{ action }}"{% endif %}{% if product %} data-product="{{ product }}"{% endif %}>{{ resolvedLabel }}{% if showArrow !== false %} <svg class="icon-arrow-right" aria-hidden="true" focusable="false" viewBox="0 0 512 512"><path d="M502.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L402.7 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l370.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z" fill="currentColor"/></svg>{% endif %}</button>
{%- endif -%}
{% endmacro %}
