{#
  产品分类 Bento 展厅 · 六语言共用（2026-11-05 重构）
  ────────────────────────────────────────────────────────────
  数据源：src/_taxonomy/taxonomy.json → scripts/build-taxonomy.js 生成 productCatalog.js
         文案由各语言 L1 页原样抽出，本模板不含硬编码文案。
         改文案 = 改 taxonomy.json 对应语言条目，再跑 node scripts/build-taxonomy.js。

  结构：3 列 Bento 网格（桌面）
        · Power Bank（第一条）与 Car Charger（最后一条）跨 2 列
        · 其余各占 1 列 → 两行各 3 个格位
        · 每格：序号 + 品类名（H2 链接）+ 规格副标题 + 子类 chips + 型号数 + 主图
        · 主图贴右下角，白底抠图与白卡无缝；不套圆形、不裁切产品

  ⚠️ 保留 id="product-grid" 与 data-section="products"（校验器/JS 依赖）
  ⚠️ H2 仍是 4 个品类名，数量和层级与重构前一致（validate-nonblog-headings 依赖）
  ⚠️ 子系列 chips 只在 ≥2 个时渲染（GaN / Car 各 1 个，渲染会与标题重复）
#}
{%- set L = lang or 'en' -%}
{%- set catalog = productCatalog[L] -%}
{%- if catalog and catalog.ranges and catalog.ranges.length -%}
<section id="product-grid" class="sec bg-darkBg text-white dark-section relative overflow-hidden" data-section="products">
 <div class="absolute inset-0 opacity-[0.03] pointer-events-none" aria-hidden="true">
  <svg width="100%" height="100%"><pattern id="bentoGridPattern" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/></pattern><rect width="100%" height="100%" fill="url(#bentoGridPattern)" /></svg>
 </div>
 <div class="container-wide relative z-10">
  <div class="bento-grid">
   {%- for r in catalog.ranges %}

   {%- if r.more.hard -%}
    {%- set moreLabel = r.more.hard -%}
   {%- elif r.more.filter == 'productCategoryModelCount' -%}
    {%- set moreLabel = r.more.before + (r.more.key | productCategoryModelCount) + r.more.after -%}
   {%- else -%}
    {%- set moreLabel = r.more.before + (r.more.key | productCategoryItemCount) + r.more.after -%}
   {%- endif -%}

   {%- set lead = r.families[0] -%}
   {%- set band = r.bandImg or (lead.img if lead else null) -%}
   <article class="bento-card{% if loop.first or loop.last %} bento-card--wide{% endif %}">
    <span class="bento-index" aria-hidden="true">0{{ loop.index }}</span>
    <h2 class="bento-title"><a class="bento-link" href="{{ r.href }}">{{ r.name | safe }}</a></h2>
    {%- if r.subtitle %}
    <p class="bento-sub">{{ r.subtitle }}</p>
    {%- endif %}
    {%- if r.families.length > 1 %}
    <ul class="bento-chips">
     {%- for f in r.families %}
     <li class="bento-chip">{{ f.name }}</li>
     {%- endfor %}
    </ul>
    {%- endif %}
    <div class="bento-foot">
     <span class="bento-count">{{ moreLabel }}</span>
    </div>
    {%- if band and band.src %}
    <img class="bento-img" src="{{ band.src }}"
     {%- if band.srcset %} srcset="{{ band.srcset }}"{% endif %}
     sizes="(min-width: 1024px) 420px, (min-width: 768px) 46vw, 68vw"
     alt="{{ band.alt }}"
     {%- if band.width %} width="{{ band.width }}"{% endif %}
     {%- if band.height %} height="{{ band.height }}"{% endif %}
     loading="lazy" decoding="async">
    {%- endif %}
   </article>
   {%- endfor %}
  </div>
 </div>
</section>
{%- endif -%}
