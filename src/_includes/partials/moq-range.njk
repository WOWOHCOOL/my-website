{# Parent category: compact MOQ / lead-time range block (DE) #}
<section id="moq-lead-time" class="sec bg-white border-t border-slate-100" data-section="content">
 <div class="container-wide">
  {{ sectionHeader('MOQ & Lieferzeit', 'Von 500 bis <span class="text-brandOrange">3.000+ Stück</span>', 'Drei Stufen — gleiche Konditionen für alle Produktlinien.', {max: '', mb: 'mb-12'}) }}
  <div class="grid md:grid-cols-3 gap-6 cap-grid">
   <article class="cap-tile reveal">
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-3">ODM Stock · MOQ 500</h3>
