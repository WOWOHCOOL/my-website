{# post-meta.njk — standard article meta line (3 items: published / updated / read-time).
   Author is shown by the author bar above — do not duplicate it here.
   Usage: {% from "partials/post-meta.njk" import postMeta %}
          {{ postMeta(date, modified, readTime, lang) }}
   `date`/`modified`/`lang` must be passed explicitly — macro scope does not see page frontmatter. #}
{% macro postMeta(date, modified, readTime, lang) %}
<div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-500 pb-8 border-b border-slate-200">
 <span><svg class="icon-calendar mr-2" aria-hidden="true" focusable="false" viewBox="0 0 448 512"><path d="M128 0C110.3 0 96 14.3 96 32l0 32-32 0C28.7 64 0 92.7 0 128l0 48 448 0 0-48c0-35.3-28.7-64-64-64l-32 0 0-32c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 32-128 0 0-32c0-17.7-14.3-32-32-32zM0 224L0 416c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-192-448 0z" fill="currentColor"/></svg><time datetime="{{ date | fmtDate }}">{{ date | dateDisplay(lang) }}</time></span>
 <span class="inline-flex items-center"><svg class="icon-rotate-right mr-1.5" aria-hidden="true" focusable="false" viewBox="0 0 512 512"><path d="M463.5 224l8.5 0c13.3 0 24-10.7 24-24l0-128c0-9.7-5.8-18.5-14.8-22.2s-19.3-1.7-26.2 5.2L413.4 96.6c-87.6-86.5-228.7-86.2-315.8 1c-87.5 87.5-87.5 229.3 0 316.8s229.3 87.5 316.8 0c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0c-62.5 62.5-163.8 62.5-226.3 0s-62.5-163.8 0-226.3c62.2-62.2 162.7-62.5 225.3-1L327 183c-6.9 6.9-8.9 17.2-5.2 26.2s12.5 14.8 22.2 14.8l119.5 0z" fill="currentColor"/></svg> {{ lang | updatedLabel }} <time datetime="{{ modified | fmtDate }}">{{ modified | dateDisplay(lang) }}</time></span>
 <span><svg class="icon-clock mr-2" aria-hidden="true" focusable="false" viewBox="0 0 512 512"><path d="M256 0a256 256 0 1 1 0 512 256 256 0 1 1 0-512zM232 120l0 136c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2 280 120c0-13.3-10.7-24-24-24s-24 10.7-24 24z" fill="currentColor"/></svg>{{ readTime }}</span>
</div>
{% endmacro %}
