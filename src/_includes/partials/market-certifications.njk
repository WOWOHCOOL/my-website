{#
  Market certification table for EN product subpages.
  Usage:
    {% set certProfile = "power-bank" %}
    {% include "partials/market-certifications.njk" %}
  Profiles live in src/_data/certProfiles.js.
#}
{% from "partials/section-header.njk" import sectionHeader with context %}
{%- set L = lang or 'en' -%}
{%- set t = (productPageI18n[L] or productPageI18n.en).marketCertifications -%}
{%- set certBg = certBg or 'bg-white' -%}
{%- set prof = (t.profiles and t.profiles[certProfile]) or certProfiles[certProfile] -%}
{%- if prof -%}
<section id="market-certifications" class="sec {{ certBg }}" data-section="content">
 <div class="container-wide">
  {{ sectionHeader(t.label, t.title, t.desc, {max: '', mb: 'mb-12'}) }}
  <div class="max-w-4xl mx-auto overflow-x-auto reveal rounded-2xl border border-slate-200 shadow-sm bg-white">
   <table class="w-full text-sm border-collapse terms-table">
    <caption class="sr-only">{{ t.caption }}</caption>
    <thead>
     <tr class="bg-brandBlue text-white text-left">
      <th scope="col" class="p-4 font-black w-1/4">{{ t.market }}</th>
      <th scope="col" class="p-4 font-black">{{ t.standards }}</th>
     </tr>
    </thead>
    <tbody>
     {%- for row in prof.rows %}
     <tr class="border-b border-slate-100 align-top{% if loop.index is even %} bg-slate-50{% endif %}">
      <td class="p-4 font-bold text-brandBlue">{{ row.market }}</td>
      <td class="p-4 text-slate-600">{{ row.standards }}</td>
     </tr>
     {%- endfor %}
    </tbody>
   </table>
  </div>
  <p class="text-xs text-slate-400 mt-4 text-center">{{ prof.note }}</p>
 </div>
</section>
{%- endif -%}
