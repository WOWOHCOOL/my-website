{# 
  型号卡 · 六语言共用模板（2026-10-29 单一真源）
  ────────────────────────────────────────────────────────────
  用法：
    {% set family = "products/power-bank/semi-solid-state" %}
    {% include "partials/product-models.njk" %}

  数据源：src/_products/<category>__<family>.json（一个产品系列一个文件）
          · 型号集合 / 规格行 structures 以该文件为准
          · 参数名统一走 src/_data/specLabels.json 本土化
          · name / badges / chips / h2 / intro / specValues 按语言本土化
          · 缺失语言字段回退 EN

  设计（2026-11-04 重构）：
    · 产品子页回到“产品图 + 关键 chips + 折叠完整规格 + CTA”的图卡模式
    · 桌面 3 列，平板 2 列，移动 1 列；图片优先，参数不占满整屏
    · 关键 chips 保持可见；完整规格进 <details>，但仍在 HTML 中
    · 数据仍由单一真源驱动，禁止回到手写型号卡

  ⚠️ 型号卡 id 必须保持 `wop09` 这种小写 anchor —— 站外有 /products/...#wop09 这类深链。
  ⚠️ data-product 传 SKU（不是分类名），询盘邮件 subject 才能带上具体型号。
  ⚠️ 标题层级：section 内 h2 = 系列名，型号名 h3 —— 与改前一致，不新增层级。
  ⚠️ 型号卡不单独声明 Product。询盘型型号没有公开价格/评价，声明 Product 会缺 offers/review/aggregateRating，导致 Product snippet 无效。
#}
{%- set L = lang or 'en' -%}
{%- set specDetailsLabels = {
  en: "Full Specifications",
  de: "Technische Daten",
  es: "Especificaciones completas",
  fr: "Spécifications complètes",
  ru: "Полные характеристики",
  pl: "Pełna specyfikacja"
} -%}
{%- set detailsLabel = specDetailsLabels[L] or specDetailsLabels.en -%}
{%- set fam = productModels[L][family] -%}
{%- if fam and fam.groups and fam.groups.length -%}

{%- for g in fam.groups %}
<section id="{{ g.sectionId }}" class="sec bg-white" data-section="products">
 <div class="container-wide">
  {%- if g.eyebrow %}
  <p class="model-section-eyebrow">{{ g.eyebrow }}</p>
  {%- endif %}
  <h2 class="model-section-title">{{ g.h2 }}</h2>
  {%- if g.intro %}
  <p class="model-section-intro">{{ g.intro }}</p>
  {%- endif %}

  <div class="model-list">
   {%- for m in g.models %}
   <article class="model-card reveal" id="{{ m.anchor | default(m.sku | lower) }}"{% if m.capacity %} data-capacity="{{ m.capacity }}"{% endif %}>
    <div class="model-media">
     {%- if m.img and m.img.src %}
     <img src="{{ m.img.src }}"
      {%- if m.img.srcset %} srcset="{{ m.img.srcset }}"{% endif %}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 48vw, 92vw"
      alt="{{ m.img.alt }}"
      {%- if m.img.width %} width="{{ m.img.width }}"{% endif %}
      {%- if m.img.height %} height="{{ m.img.height }}"{% endif %}
      loading="lazy" decoding="async">
     {%- endif %}
     {%- if m.badges and m.badges.length %}
     <div class="model-badges">
      {%- for b in m.badges %}
      <span class="model-badge{% if loop.first %} model-badge--accent{% endif %}">{{ b }}</span>
      {%- endfor %}
     </div>
     {%- endif %}
    </div>

    <div class="model-body">
     <h3 class="model-name">{{ m.name }}</h3>

     {%- if m.description %}
     <p class="model-desc">{{ m.description }}</p>
     {%- endif %}

     {%- if m.chips and m.chips.length %}
     <ul class="model-chips">
      {%- for c in m.chips %}
      {%- if loop.index <= 4 %}<li>{{ c }}</li>{% endif %}
      {%- endfor %}
     </ul>
     {%- endif %}

     {%- if m.rows and m.rows.length %}
     <details class="model-specs-details">
      <summary>{{ detailsLabel }}</summary>
      <div class="model-specs-wrap">
       <table class="model-specs">
        <caption class="sr-only">{{ m.name }}</caption>
        <tbody>
         {%- for row in m.rows %}
         <tr><th scope="row">{{ specLabels[L] and specLabels[L][row[0]] or row[0] }}</th><td>{{ row[1] }}</td></tr>
         {%- endfor %}
        </tbody>
       </table>
      </div>
     </details>
     {%- endif %}

     <div class="model-cta">
      <button type="button" data-action="open-modal" data-product="{{ m.sku }}" class="btn-solid model-btn">
       {{ ctaLabels.factoryPricing[L] }}
      </button>
     </div>
    </div>
   </article>
   {%- endfor %}
  </div>
 </div>
</section>

<script type="application/ld+json">
[
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "https://www.wowohcool.com{{ page.url }}#itemlist-{{ g.sectionId }}",
  "url": "https://www.wowohcool.com{{ page.url }}",
  "name": {{ g.h2 | dump | safe }},
  "numberOfItems": {{ g.models.length }},
  "itemListElement": [
{%- for m in g.models %}
    { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ m.name | dump | safe }}, "url": "https://www.wowohcool.com{{ page.url }}#{{ m.anchor | default(m.sku | lower) }}" }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
]
</script>
{%- endfor %}

{%- endif -%}
