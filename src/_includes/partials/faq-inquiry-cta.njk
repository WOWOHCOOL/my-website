{% from "partials/cta-button.njk" import ctaButton as ctaButtonMacro with context %}
{# FAQ-end popup inquiry CTA (localized via i18n.faqInquiryCta[lang]). #}
{%- set fc = i18n.faqInquiryCta[lang] -%}
<div class="mt-12 text-center reveal" data-faq-conversion>
 <p class="text-slate-600 leading-relaxed max-w-2xl mx-auto mb-6">{{ fc.hook }}</p>
 {{ ctaButtonMacro("factoryPricing", "primary", "open-modal", "", "", fc.button) }}
 <p class="mt-6 text-sm text-slate-500 leading-relaxed">{{ fc.or }} <a href="{{ fc.serviceHref }}" class="text-brandOrange font-bold hover:underline">{{ fc.serviceLabel }}</a> {{ fc.or2 }} <a href="{{ fc.contactHref }}" class="text-brandOrange font-bold hover:underline">{{ fc.contactLabel }}</a>.</p>
</div>
