{#
  子页通用：商务条款 + 质检售后（EN）
  用法：
    {% set rangeLabel = "semi-solid-state power bank" %}
    {% include "partials/subpage-commercial-support.njk" %}
  说明：数据走 facts.json token；只放 EN 子页，其他语言页各自维护。
#}
<!-- ======== COMMERCIAL TERMS ======== -->
<section id="commercial-terms" class="sec bg-white" data-section="content">
 <div class="container-wide">
  {{ sectionHeader('Working Together', 'MOQ, Lead Times &amp; <span class="text-brandOrange">Trade Terms</span>', 'The same terms apply across the full ' ~ (rangeLabel or 'product') ~ ' range. Figures are factory-direct and confirmed in your quotation.', {max: '', mb: 'mb-12'}) }}
  <div class="max-w-4xl mx-auto overflow-x-auto reveal rounded-xl border border-slate-200">
   <table class="w-full text-sm border-collapse terms-table">
    <caption class="sr-only">MOQ, sampling, production and trade terms</caption>
    <thead>
     <tr class="bg-brandBlue text-white text-left">
      <th scope="col" class="p-4 font-black w-1/3">Item</th>
      <th scope="col" class="p-4 font-black">Standard terms</th>
     </tr>
    </thead>
    <tbody>
     <tr class="border-b border-slate-100 align-top terms-highlight">
      <td class="p-4 font-bold text-brandBlue">MOQ</td>
      <td class="p-4 text-slate-600">From {FACT:moq.stock} units (in-stock ODM) · {FACT:moq.dev} units (ODM development) · {FACT:moq.full} units (full OEM with new tooling)</td>
     </tr>
     <tr class="border-b border-slate-100 align-top bg-slate-50">
      <td class="p-4 font-bold text-brandBlue">Sampling</td>
      <td class="p-4 text-slate-600">{FACT:timeline.odmStockSample} for in-stock ODM · {FACT:timeline.oemSample} for OEM</td>
     </tr>
     <tr class="border-b border-slate-100 align-top">
      <td class="p-4 font-bold text-brandBlue">Mass production</td>
      <td class="p-4 text-slate-600">{FACT:timeline.odmStockProduction} for in-stock ODM · {FACT:timeline.odmNewDevelopmentProduction} for ODM development · {FACT:timeline.oemProduction} for OEM · {FACT:timeline.rushProduction} for rush orders</td>
     </tr>
     <tr class="border-b border-slate-100 align-top bg-slate-50">
      <td class="p-4 font-bold text-brandBlue">Payment</td>
      <td class="p-4 text-slate-600">{FACT:contact.paymentBase}</td>
     </tr>
     <tr class="border-b border-slate-100 align-top">
      <td class="p-4 font-bold text-brandBlue">Trade terms</td>
      <td class="p-4 text-slate-600">{FACT:contact.shipping}</td>
     </tr>
     <tr class="align-top bg-slate-50">
      <td class="p-4 font-bold text-brandBlue">Packaging</td>
      <td class="p-4 text-slate-600">Retail gift box, blister or FNSKU/FBA-ready carton</td>
     </tr>
    </tbody>
   </table>
  </div>
 </div>
</section>

<!-- ======== QUALITY & AFTER-SALES ======== -->
<section id="service-support" class="sec bg-slate-50" data-section="content">
 <div class="container-wide">
  {{ sectionHeader('Quality &amp; Support', 'From Sample to <span class="text-brandOrange">After-Sales</span>', 'Four inspection stages, 100% aging and a documented warranty on every ' ~ (rangeLabel or 'product') ~ ' order.', {max: '', mb: 'mb-12'}) }}
  <ol class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">01</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">Spec Review</h3>
    <p class="text-sm text-slate-600 leading-relaxed">Share capacity, output, port layout and target market. We shortlist matching stock models or scope a development project.</p>
   </li>
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">02</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">Sampling</h3>
    <p class="text-sm text-slate-600 leading-relaxed">{FACT:timeline.odmStockSample} for in-stock ODM and {FACT:timeline.oemSample} for OEM. Sample fees are refundable on bulk orders.</p>
   </li>
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">03</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">Incoming &amp; In-Process QC</h3>
    <p class="text-sm text-slate-600 leading-relaxed">Cells, ICs, PCBs and connectors checked at IQC. Soldering, component placement and wiring monitored at IPQC.</p>
   </li>
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">04</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">Final &amp; Outgoing QC</h3>
    <p class="text-sm text-slate-600 leading-relaxed">100% 4-hour aging, charge and discharge performance and port function tests at FQC. Packaging and labelling checked at OQC.</p>
   </li>
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">05</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">Pre-Shipment Inspection</h3>
    <p class="text-sm text-slate-600 leading-relaxed">AQL 0.65 normal and 0.25 tightened sampling, with defect rate held below 0.3% and on-time delivery above 97%.</p>
   </li>
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">06</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">Warranty &amp; After-Sales</h3>
    <p class="text-sm text-slate-600 leading-relaxed">{FACT:contact.warrantyMonths}-month warranty, spare parts, technical documentation and UN38.3/MSDS files for transport.</p>
   </li>
  </ol>
 </div>
</section>
