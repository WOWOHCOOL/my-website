{#
  子页通用：商务条款 + 质检售后（多语言）
  用法：
    {% set rangeLabel = "semi-solid-state power bank" %}
    {% include "partials/subpage-commercial-support.njk" %}
  字符串走 src/_data/productPageI18n.js；facts token 保持原样，由 facts.json transform 替换。
#}
{%- set L = lang or 'en' -%}
{%- set t = (productPageI18n[L] or productPageI18n.en).commercialSupport -%}
{%- set rl = rangeLabel or 'product' -%}
{%- set termsBg = termsBg or 'bg-white' -%}
{%- set supportBg = supportBg or 'bg-slate-50' -%}
<!-- ======== COMMERCIAL TERMS ======== -->
<section id="commercial-terms" class="sec {{ termsBg }}" data-section="content">
 <div class="container-wide">
  {{ sectionHeader(t.termsLabel, t.termsTitle, t.termsDesc | replace('{range}', rl), {max: '', mb: 'mb-12'}) }}
  <div class="max-w-4xl mx-auto overflow-x-auto reveal rounded-2xl border border-slate-200 shadow-sm bg-white">
   <table class="w-full text-sm border-collapse terms-table">
    <caption class="sr-only">{{ t.caption }}</caption>
    <thead>
     <tr class="bg-brandBlue text-white text-left">
      <th scope="col" class="p-4 font-black w-1/3">{{ t.item }}</th>
      <th scope="col" class="p-4 font-black">{{ t.standardTerms }}</th>
     </tr>
    </thead>
    <tbody>
     <tr class="border-b border-slate-100 align-top terms-highlight">
      <td class="p-4 font-bold text-brandBlue">{{ t.rows.moq }}</td>
      <td class="p-4 text-slate-600">{{ t.values.moq | safe }}</td>
     </tr>
     <tr class="border-b border-slate-100 align-top bg-slate-50">
      <td class="p-4 font-bold text-brandBlue">{{ t.rows.sampling }}</td>
      <td class="p-4 text-slate-600">{{ t.values.sampling | safe }}</td>
     </tr>
     <tr class="border-b border-slate-100 align-top">
      <td class="p-4 font-bold text-brandBlue">{{ t.rows.mass }}</td>
      <td class="p-4 text-slate-600">{{ t.values.mass | safe }}</td>
     </tr>
     <tr class="border-b border-slate-100 align-top bg-slate-50">
      <td class="p-4 font-bold text-brandBlue">{{ t.rows.payment }}</td>
      <td class="p-4 text-slate-600">{{ t.values.payment | safe }}</td>
     </tr>
     <tr class="border-b border-slate-100 align-top">
      <td class="p-4 font-bold text-brandBlue">{{ t.rows.trade }}</td>
      <td class="p-4 text-slate-600">{{ t.values.trade | safe }}</td>
     </tr>
     <tr class="align-top bg-slate-50">
      <td class="p-4 font-bold text-brandBlue">{{ t.rows.packaging }}</td>
      <td class="p-4 text-slate-600">{{ t.values.packaging | safe }}</td>
     </tr>
    </tbody>
   </table>
  </div>
 </div>
</section>

<!-- ======== QUALITY & AFTER-SALES ======== -->
<section id="service-support" class="sec {{ supportBg }}" data-section="content">
 <div class="container-wide">
  {{ sectionHeader(t.qualityLabel, t.qualityTitle, t.qualityDesc | replace('{range}', rl), {max: '', mb: 'mb-12'}) }}
  <ol class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
   {%- for step in t.steps %}
   <li class="card-soft bg-white p-6 reveal">
    <span class="qc-num">{{ "0" ~ loop.index }}</span>
    <h3 class="text-base font-black text-brandBlue uppercase italic mb-2">{{ step.title | safe }}</h3>
    <p class="text-sm text-slate-600 leading-relaxed">{{ step.desc | safe }}</p>
   </li>
   {%- endfor %}
  </ol>
 </div>
</section>
