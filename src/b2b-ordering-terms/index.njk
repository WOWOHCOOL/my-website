 <tbody class="divide-y divide-slate-100">
 <tr><td class="p-4 font-bold text-slate-800">In-stock ODM (500)</td><td class="p-4 text-slate-600">3–7 days</td><td class="p-4 text-slate-600">25–35 days</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">ODM development, stock packaging (1,000)</td><td class="p-4 text-slate-600">25–45 days</td><td class="p-4 text-slate-600">25–35 days</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">ODM development, branded box (2,000)</td><td class="p-4 text-slate-600">25–45 days</td><td class="p-4 text-slate-600">35–45 days</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">ODM development, structure changes (2,000)</td><td class="p-4 text-slate-600">25–45 days</td><td class="p-4 text-slate-600">35–50 days</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">Full OEM (3,000+)</td><td class="p-4 text-slate-600">7–14 days</td><td class="p-4 text-slate-600">30–60 days</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">OEM with new mold development</td><td class="p-4 text-slate-600">—</td><td class="p-4 text-slate-600">+2–3 months tooling; 2–4 months overall</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">Express production</td><td class="p-4 text-slate-600">—</td><td class="p-4 text-slate-600">15–20 days (rush surcharge applies)</td></tr>
 </tbody>
