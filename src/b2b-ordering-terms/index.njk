 </tr>
 </thead>
 <tbody class="divide-y divide-slate-100">
 <tr><td class="p-4 font-bold text-slate-800">Power banks</td><td class="p-4 text-slate-600">12 months</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">Wireless chargers</td><td class="p-4 text-slate-600">12 months</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">GaN chargers</td><td class="p-4 font-black text-brandBlue">24 months</td></tr>
 <tr><td class="p-4 font-bold text-slate-800">Car chargers</td><td class="p-4 font-black text-brandBlue">24 months</td></tr>
 </tbody>
 </table>
