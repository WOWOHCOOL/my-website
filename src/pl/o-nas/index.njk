 <a href="/pl/kontakt/" class="inline-flex items-center justify-center gap-2 border-2 border-brandBlue text-brandBlue px-6 py-3.5 rounded-xl font-black uppercase tracking-widest text-[11px] hover:bg-brandBlue hover:text-white transition flex-1">Kontakt →</a>
 </div>
