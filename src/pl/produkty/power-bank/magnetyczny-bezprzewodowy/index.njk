     <tr class="border-t border-slate-100"><td class="p-4 text-slate-700 font-semibold">Magnetyczne pozycjonowanie</td><td class="p-4 text-center text-slate-600">Nie</td><td class="p-4 text-center bg-brandOrange/5 border-x border-brandOrange/20 font-bold text-slate-900">Tak (N52H)</td><td class="p-4 text-center text-slate-600">Tak</td></tr>
