          </thead>
          <tbody class="bg-white">
            <tr class="border-b border-slate-100"><td class="p-3">Cena jednostkowa</td><td class="p-3">Niższa</td><td class="p-3">+8-15%</td></tr>
            <tr class="border-b border-slate-100"><td class="p-3">Ryzyko celne</td><td class="p-3">Na importerze</td><td class="p-3">Na dostawcy</td></tr>
