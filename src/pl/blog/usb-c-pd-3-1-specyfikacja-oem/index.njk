      <tr class="border-t border-slate-200"><td class="p-3 font-bold text-sm">PD 100W USB 2.0 (z E-Marker)</td><td class="p-3 text-center">$1,50–3,00/szt.</td></tr>
      <tr class="border-t border-slate-200"><td class="p-3 font-bold text-sm">PD 100W USB 3.2 10 Gbps</td><td class="p-3 text-center">$3,50–6,00/szt.</td></tr>
