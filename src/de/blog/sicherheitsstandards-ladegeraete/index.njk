 <tr class="hover:bg-slate-50"><td class="px-5 py-4 text-sm font-bold">5</td><td class="px-5 py-4 text-sm">Akkreditierter Pruefbericht</td><td class="px-5 py-4 text-sm text-slate-600">Von ISO/IEC 17025 Labor, gegen EN IEC 62368-1:2020+A11:2021</td></tr>
