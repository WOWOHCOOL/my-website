 <tr class="border-t border-slate-200"><td class="p-3 font-bold text-sm">20.000 mAh</td><td class="p-3 text-center">~3,8</td><td class="p-3 text-center">~2,5</td><td class="p-3 text-center">~2,7</td><td class="p-3 text-center">~1,7</td></tr>
 <tr><td class="p-3 font-bold text-sm">27.000 mAh</td><td class="p-3 text-center">~5,1</td><td class="p-3 text-center">~3,4</td><td class="p-3 text-center">~3,6</td><td class="p-3 text-center">~2,3</td></tr>
