       <tr class="bg-white"><td class="p-3 font-bold">Bande interdite</td><td class="p-3 text-brandBlue font-bold">3,4 eV</td><td class="p-3">1,12 eV</td></tr>
       <tr class="bg-slate-50"><td class="p-3 font-bold">Rendement</td><td class="p-3 text-brandBlue font-bold">93-95%</td><td class="p-3">~85%</td></tr>
       <tr class="bg-white"><td class="p-3 font-bold">Fréquence de commutation</td><td class="p-3 text-brandBlue font-bold">~1 MHz</td><td class="p-3">100-500 kHz</td></tr>
       <tr class="bg-slate-50"><td class="p-3 font-bold">Taille (65W)</td><td class="p-3 text-brandBlue font-bold">~40-55 cm³</td><td class="p-3">~90-130 cm³</td></tr>
       <tr class="bg-white"><td class="p-3 font-bold">Température de surface*</td><td class="p-3 text-brandBlue font-bold">52,4°C</td><td class="p-3">76,8°C</td></tr>
       <tr class="bg-slate-50"><td class="p-3 font-bold">Durée de vie</td><td class="p-3 text-brandBlue font-bold">50 000+ h</td><td class="p-3">20 000-30 000 h</td></tr>
       <tr class="bg-white"><td class="p-3 font-bold">Ports (multiport)</td><td class="p-3 text-brandBlue font-bold">2-4 ports</td><td class="p-3">1-2 ports</td></tr>
      </tbody>
     </table>
