 <tr class="bg-white"><td class="p-3 font-bold">RoHS</td><td class="p-3 text-center"><span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs font-bold rounded-full">Oui</span></td><td class="p-3 text-center">300-500 EUR</td><td class="p-3 text-center">2-3 sem.</td></tr>
 <tr class="bg-slate-50"><td class="p-3 font-bold">SYDEREP (DEEE)</td><td class="p-3 text-center"><span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs font-bold rounded-full">Oui</span></td><td class="p-3 text-center">Gratuit</td><td class="p-3 text-center">1-2 sem.</td></tr>
