    <table class="w-full text-sm">
     <thead class="bg-brandBlue text-white">
      <tr><th class="text-left p-3 font-black uppercase text-xs">Incoterm</th><th class="text-center p-3 font-black uppercase text-xs">Risque acheteur</th><th class="text-center p-3 font-black uppercase text-xs">Contrôle coûts</th><th class="text-right p-3 font-black uppercase text-xs">Recommandation</th></tr>
     </thead>
     <tbody>
      <tr class="bg-white"><td class="p-3 font-bold">DDP</td><td class="p-3 text-center text-green-600 font-black">Minimal</td><td class="p-3 text-center">Faible</td><td class="p-3 text-right"><span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-black rounded-full">✅ 1ère commande</span></td></tr>
      <tr class="bg-slate-50"><td class="p-3 font-bold">FOB</td><td class="p-3 text-center text-amber-600 font-black">Moyen</td><td class="p-3 text-center">Élevé</td><td class="p-3 text-right"><span class="px-2 py-1 bg-amber-100 text-amber-700 text-xs font-black rounded-full">⚠️ Importateurs expérimentés</span></td></tr>
      <tr class="bg-white"><td class="p-3 font-bold">EXW</td><td class="p-3 text-center text-red-600 font-black">Maximal</td><td class="p-3 text-center">Maximal</td><td class="p-3 text-right"><span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-black rounded-full">❌ Uniquement avec agent en Chine</span></td></tr>
     </tbody>
    </table>
   </div>
