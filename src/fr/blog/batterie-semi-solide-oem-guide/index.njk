 <tr class="border-t border-slate-200 bg-slate-50"><td class="p-4 font-bold">CE (LVD + EMC)</td><td class="p-4 text-center">$1 500-3 500</td><td class="p-4 text-center">2-4 sem.</td><td class="p-4">Oui</td></tr>
 <tr class="border-t border-slate-200"><td class="p-4 font-bold">RoHS</td><td class="p-4 text-center">$500-1 000</td><td class="p-4 text-center">1-2 sem.</td><td class="p-4">Oui</td></tr>
