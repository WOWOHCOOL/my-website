 <tr class="bg-white"><td class="p-3 font-bold">Rendement a 65W</td><td class="p-3">85-90%</td><td class="p-3 text-green-600 font-bold">94-98%</td><td class="p-3">+4-13 pts</td></tr>
 <tr class="bg-slate-50"><td class="p-3 font-bold">Volume du boitier</td><td class="p-3">Reference</td><td class="p-3 text-green-600 font-bold">-40 a -50%</td><td class="p-3">Plus compact</td></tr>
 <tr class="bg-white"><td class="p-3 font-bold">Temperature apres 1h pleine charge</td><td class="p-3">65-80&deg;C</td><td class="p-3 text-green-600 font-bold">45-55&deg;C</td><td class="p-3">-20 a -25&deg;C</td></tr>
 <tr class="bg-slate-50"><td class="p-3 font-bold">Frequence de commutation</td><td class="p-3">~100 kHz</td><td class="p-3 text-green-600 font-bold">3-5 MHz</td><td class="p-3">30-50x plus rapide</td></tr>
 <tr class="bg-white"><td class="p-3 font-bold">Puissance max USB-C</td><td class="p-3">~100W PD 3.0</td><td class="p-3 text-green-600 font-bold">240W PD 3.1 EPR</td><td class="p-3">2,4x plus puissant</td></tr>
 <tr class="bg-slate-50"><td class="p-3 font-bold">Marge brute OEM (65W)</td><td class="p-3">35-45%</td><td class="p-3 text-green-600 font-bold">55-65%</td><td class="p-3">+20 pts</td></tr>
 </tbody>
