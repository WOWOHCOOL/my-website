      <tr><td class="p-3 font-bold text-brandBlue">48V</td><td class="p-3 text-center text-brandBlue font-bold">240W</td><td class="p-3 text-slate-600 text-sm">Remplacements de bureau, vélos électriques, outils, futurs appareils</td><td class="p-3 text-center"><span class="px-2 py-1 bg-brandOrange/10 text-brandOrange text-xs font-black rounded-full">EPR</span></td></tr>
