      <tr class="border-t border-slate-200"><td class="p-3 font-bold">20V</td><td class="p-3 text-center">100W</td><td class="p-3 text-slate-600 text-sm">La plupart des ultrabooks (MacBook Air, Dell XPS 13)</td><td class="p-3 text-center"><span class="px-2 py-1 bg-slate-100 text-slate-600 text-xs font-black rounded-full">SPR</span></td></tr>
