            <tr class="border-b border-slate-100"><td class="p-3">Échantillons 3-5 unités</td><td class="p-3">300-800 $</td><td class="p-3">Toute commande, étape obligatoire</td></tr>
            <tr class="border-b border-slate-100"><td class="p-3">Audit technique (tiers)</td><td class="p-3">450-900 €</td><td class="p-3">Commandes au-delà de 50 000 $</td></tr>
            <tr><td class="p-3">SGS / Bureau Veritas</td><td class="p-3">600-1 400 €/jour</td><td class="p-3">Produits phares</td></tr>
