{% block faqContent %}
<section class="sec bg-white">
 <div class="container-narrow">
 {{ sectionHeader("Catégories FAQ", "Tout ce que vous devez savoir", "Des réponses rapides a vos questions. Notre équipe est a votre disposition.") }}

 <!-- Quick-jump Navigation -->
 <div class="flex flex-wrap justify-center gap-2 mb-12 reveal">
  <a href="#faq-commande" class="filter-chip">Commande &amp; Devis</a>
  <a href="#faq-production" class="filter-chip">Production &amp; Qualité</a>
  <a href="#faq-livraison" class="filter-chip">Livraison &amp; Logistique</a>
