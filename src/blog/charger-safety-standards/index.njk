 <tr><td class="p-3 text-slate-600 font-bold">X Capacitor (L→N)</td><td class="p-3 text-slate-600">IEC 60384-14 Class X2</td><td class="p-3 text-slate-600">≥275V AC rated</td></tr>
 <tr><td class="p-3 text-slate-600 font-bold">Bridge Rectifier</td><td class="p-3 text-slate-600">IEC 60115-1</td><td class="p-3 text-slate-600">≥600V PRV, ≥2× rated current</td></tr>
