 <h1 class="text-3xl lg:text-5xl font-black text-brandBlue uppercase italic tracking-tighter leading-tight mb-6">China Charger Supplier Guide: Factory Verification & OEM Tips</h1>
<!-- Compact Author Bar -->
 <div class="flex items-center gap-3 mb-6">
