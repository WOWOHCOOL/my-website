 <tr class="bg-slate-50"><td class="p-3 font-bold">3 201-10 000</td><td class="p-3">L</td><td class="p-3"><data value="200">200</data></td><td class="p-3"><data value="10">10</data> / <data value="11">11</data></td><td class="p-3"><data value="14">14</data> / <data value="15">15</data></td></tr>
