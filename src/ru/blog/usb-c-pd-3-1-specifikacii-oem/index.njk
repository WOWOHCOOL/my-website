      </tr>
     </thead>
     <tbody>
      <tr class="border-t border-slate-200"><td class="p-3 font-bold text-sm">Макс. мощность</td><td class="p-3 text-center">100W</td><td class="p-3 text-center text-brandBlue font-bold">240W</td><td class="p-3 text-center">240W (без изменений)</td></tr>
      <tr class="border-t border-slate-200"><td class="p-3 font-bold text-sm">Ступени напряжения</td><td class="p-3 text-center">5V, 9V, 15V, 20V</td><td class="p-3 text-center text-brandBlue font-bold">+ 28V, 36V, 48V</td><td class="p-3 text-center">Как в 3.1</td></tr>
