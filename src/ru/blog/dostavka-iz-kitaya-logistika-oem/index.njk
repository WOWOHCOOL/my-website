      <tr class="bg-slate-50"><td class="p-3 font-bold">TIR авто DDP</td><td class="p-3 text-right">$1.85</td><td class="p-3 text-right">28%</td><td class="p-3 text-right font-black text-brandBlue">$8.35</td></tr>
