  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://www.wowohcool.com/products/#faq",
  "url": "https://www.wowohcool.com/products/",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the MOQ for OEM/ODM orders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our MOQ starts at 500 units per SKU for ODM on in-stock models, 1,000-2,000 units for ODM new development, and 3,000+ units for OEM with new tooling. We offer flexible MOQ options for startup brands, contact us to discuss your requirements."
      }
    },
    {
      "@type": "Question",
      "name": "Can I request samples before bulk ordering?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Standard samples are available within 3-7 days. Sample fees are typically refundable upon placement of a bulk order. We encourage sample testing to verify quality and compatibility."
      }
    },
    {
      "@type": "Question",
      "name": "What certifications do your products carry?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All products are engineered to meet global standards including CE, FCC, RoHS, and Qi/Qi2. Power banks are UN38.3 certified. We also assist clients in obtaining UL, PSE, KC, and other market-specific certifications."
      }
    },
    {
      "@type": "Question",
      "name": "What is the typical lead time?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard OEM orders ship within 25-30 days after sample approval. ODM projects with new tooling require approximately 45-60 days from design approval. Rush orders are available for established partners."
      }
    },
    {
      "@type": "Question",
      "name": "Are you a factory or a trading company?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We are a direct factory — an ISO 9001-certified OEM/ODM manufacturer in Shenzhen with our own production lines, R&D team and 4-stage QC. You work factory-direct, with no trading-company markup."
      }
    },
    {
      "@type": "Question",
      "name": "What product categories do you manufacture?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Four categories: power banks (including semi-solid-state), Qi2/Qi2.2 wireless chargers, GaN V fast chargers (20W–240W) and car chargers. Each category offers stock ODM models and full OEM tooling."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer logo, packaging and CMF customization?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Full OEM/ODM customization: custom logo (printing, laser, UV), Pantone CMF, retail packaging, multilingual manuals and FNSKU/FBA-ready packaging. MOQ starts at 500 units for logo-only customization."
      }
    }
  ],
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [
      ".faq-answer"
    ]
  }
}
</script>

