{
  "_comment": "Blog section registry — single source of truth for the 15-panel standard. 'renderer' points to the macro in partials/blog-sections.njk; 'kind' = shared (uniform frame) | unique (article-specific body) | global (layout/partial). 'requiredData' lists the fields a renderer needs.",
  "standard": "seomachine/context/blog-template-standard.md §二",
  "panels": [
    {
      "key": "hero",
      "order": 1,
      "kind": "shared",
      "required": true,
      "renderer": "heroPanel",
      "requiredData": [
        "breadcrumb",
        "tag",
        "h1",
        "author",
        "date",
        "modified",
        "readTime",
        "lang"
      ],
      "note": "Step-1 deferred: the hero scaffold embeds page-scoped macros breadcrumb() and postMeta() (plus a {% from %} import), so scripts/validate-blog-sections.js cannot byte-exact it in source-vs-source mode. Handle it in the data-file migration (renderer receives real breadcrumb/date/lang data) or validate against the _site render product. Every other fixed-structure panel now has a proven renderer macro."
    },
    {
      "key": "hook",
      "order": 2,
      "kind": "shared",
      "required": true,
      "renderer": "hookPanel",
      "requiredData": [
        "hook"
      ]
    },
    {
      "key": "featured-image",
      "order": 3,
      "kind": "shared",
      "required": true,
      "renderer": "featuredImage",
      "requiredData": [
        "ogImage",
        "alt"
      ]
    },
    {
      "key": "takeaways",
      "order": 4,
      "kind": "shared",
      "required": true,
      "renderer": "takeawaysPanel",
      "requiredData": [
        "items"
      ]
    },
    {
      "key": "metrics",
