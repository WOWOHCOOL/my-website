   "step": [
    {
     "@type": "HowToStep",
     "position": 1,
     "name": "IQC, Inspección de materiales entrantes",
     "itemListElement": [
      {
       "@type": "HowToDirection",
       "text": "Verifique celdas de batería (Grado A, no recicladas), chips IC, PCB, conectores y carcasas antes de que ingresen a producción. Solicite trazabilidad de lote y certificados de cada componente. El 35-50% del BOM de una power bank son las celdas: si falla el IQC aquí, el defecto se arrastra a todo el lote."
      }
     ]
    },
    {
     "@type": "HowToStep",
     "position": 2,
     "name": "IPQC, Control en proceso de producción",
     "itemListElement": [
      {
       "@type": "HowToDirection",
       "text": "Supervise soldadura SMT, colocación de componentes, cableado y montaje de PCB en tiempo real. Los defectos de soldadura representan la causa nº1 de fallos en campo en electrónica de carga. Ante cualquier desviación, el proceso se detiene y se corrige de inmediato."
      }
     ]
    },
    {
     "@type": "HowToStep",
     "position": 3,
     "name": "FQC, Prueba funcional del 100% de unidades",
     "itemListElement": [
      {
       "@type": "HowToDirection",
       "text": "Verifique potencia de carga real (PD/QC/PPS), funcionamiento de todos los puertos, botones, LEDs y pantalla. No por muestreo: el 100% de las unidades debe pasar FQC. Los productos aptos reciben un número de serie individual para trazabilidad."
      }
     ]
    },
    {
     "@type": "HowToStep",
     "position": 4,
     "name": "Aging test, Prueba de envejecimiento de 4 horas",
     "itemListElement": [
      {
       "@type": "HowToDirection",
       "text": "Cada unidad completa un ciclo carga-descarga bajo carga durante mínimo 4 horas antes del embalaje. El estándar de la industria es solo 2 horas o por muestreo. WOWOHCOOL aplica 4 horas al 100% de unidades para detectar fallos tempranos que solo aparecen tras uso prolongado."
      }
     ]
    },
    {
     "@type": "HowToStep",
     "position": 5,
     "name": "OQC, Inspección pre-embarque con muestreo AQL",
     "itemListElement": [
      {
       "@type": "HowToDirection",
       "text": "Verifique integridad del embalaje, accesorios, etiquetado CE, código de barras. Aplique AQL 2.5 para defectos mayores, AQL 0 para defectos críticos. Contrate inspección externa independiente (~$300 USD/día con SGS, TÜV o Bureau Veritas) para validación adicional."
      }
     ]
    },
    {
     "@type": "HowToStep",
     "position": 6,
     "name": "Documentación y trazabilidad completa",
     "itemListElement": [
      {
       "@type": "HowToDirection",
       "text": "Exija informes de lote, certificados de origen de celdas, datos de prueba reales, UN38.3 y MSDS antes del envío. La trazabilidad es obligatoria bajo el Reglamento UE de Baterías 2023/1542. Conserve muestras de cada pedido durante al menos 12 meses."
      }
     ]
    }
