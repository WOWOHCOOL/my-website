 <h2 class="text-2xl font-black text-brandBlue uppercase italic mb-6">6. Bases de Datos por País</h2>

 <div class="overflow-x-auto mb-6">
 <table class="w-full text-sm text-left border-collapse">
 <thead><tr class="bg-brandBlue text-white"><th class="p-3 font-black uppercase text-xs">Mercado</th><th class="p-3 font-black uppercase text-xs">Base de datos</th><th class="p-3 font-black uppercase text-xs">Qué verifica</th></tr></thead>
