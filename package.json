{
  "name": "wowohcool-web",
  "private": true,
  "scripts": {
    "dev": "node dev.mjs",
    "build:css": "npx tailwindcss -i ./css/src.css -o ./css/styles.css --minify",
    "build:js:en": "npx esbuild main.src.js --bundle --minify --outfile=main.js --define:LANG=\"\\\"en\\\"\"",
    "build:js:de": "npx esbuild main.src.js --bundle --minify --outfile=de/js/de-main.js --define:LANG=\"\\\"de\\\"\"",
    "build:js:es": "npx esbuild main.src.js --bundle --minify --outfile=es/js/es-main.js --define:LANG=\"\\\"es\\\"\"",
    "build:js:fr": "npx esbuild main.src.js --bundle --minify --outfile=fr/js/fr-main.js --define:LANG=\"\\\"fr\\\"\"",
    "build:js:ru": "npx esbuild main.src.js --bundle --minify --outfile=ru/js/ru-main.js --define:LANG=\"\\\"ru\\\"\"",
    "build:js:pl": "npx esbuild main.src.js --bundle --minify --outfile=pl/js/pl-main.js --define:LANG=\"\\\"pl\\\"\"",
    "build:js": "npm run build:js:en && npm run build:js:de && npm run build:js:es && npm run build:js:fr && npm run build:js:ru && npm run build:js:pl",
    "build": "npm run gate && npm run validate:accept && npm run validate:redirects && npm run validate:headers && npm run build:css && npm run build:js && npm run clean && npx @11ty/eleventy && node scripts/validate-html.js && node scripts/validate-offers.js && node scripts/validate-stray-lt.js && node scripts/validate-img-dims.js && node scripts/generate-sitemaps.js && node scripts/svg-sprite.js && node scripts/validate-sprite.js && node scripts/validate-img-exists.js && node scripts/validate-img-variants.js && node scripts/validate-a11y.js && node scripts/validate-links.js && node scripts/validate-og.js && node scripts/validate-speakable.js && (node scripts/indexnow-push.js || true)",
    "clean": "node scripts/clean.js",
    "gate": "node scripts/gate.js",
    "validate:accept": "node scripts/validate-accept-negotiation.js",
    "validate:html": "node scripts/validate-html.js",
    "validate:offers": "node scripts/validate-offers.js",
    "validate:stray-lt": "node scripts/validate-stray-lt.js",
    "validate:redirects": "node scripts/validate-redirects.js",
    "validate:headers": "node scripts/validate-headers.js",
    "validate:img": "node scripts/validate-img-dims.js",
    "validate:sprite": "node scripts/validate-sprite.js",
    "validate:img-exists": "node scripts/validate-img-exists.js",
    "validate:img-variants": "node scripts/validate-img-variants.js",
    "validate:a11y": "node scripts/validate-a11y.js",
    "validate:links": "node scripts/validate-links.js",
    "validate:og": "node scripts/validate-og.js",
    "validate:speakable": "node scripts/validate-speakable.js",
    "deploy": "npm run build && node scripts/indexnow-push.js --force",
    "watch:css": "npx tailwindcss -i ./css/src.css -o ./css/styles.css --minify --watch",
    "watch:js": "npx esbuild main.src.js --bundle --minify --outfile=main.js --define:LANG=\"\\\"en\\\"\" --watch",
    "watch": "npm run build:css && npx concurrently \"npm run watch:css\" \"npm run watch:js\"",
    "lint:i18n": "node scripts/lint-i18n-paths.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19"
  }
}
