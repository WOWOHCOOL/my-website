#!/bin/sh
# pre-push — run the site prepush gate before content changes leave the machine.
#
# 2026-10-19: the old B2B checker (`check_new_article.py` /
# `preflight_blog_batch.py`) was removed together with the seomachine B2B add-on.
# The hook now runs only the site-local prepush gate (`npm run prepush`), which
# covers the site validators in package.json.
#
# SCOPE: only fires when the push touches `src/**/*.njk`. Tooling-only or
# docs-only pushes are not slowed down.
#
# INSTALL (this file is the source of truth; hooks themselves are not versioned):
#     cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# REMOVE:
#     rm .git/hooks/pre-push
# BYPASS (please don't):
#     git push --no-verify

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  echo "[pre-push] not inside a git repo — skipping content gates"
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
touched=""

while read -r _local_ref local_sha_in _remote_ref remote_sha; do
  [ -z "${local_sha_in:-}" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    base_in="origin/main"
  else
    base_in="$remote_sha"
  fi
  hit=$(git diff --name-only "$base_in..$local_sha_in" 2>/dev/null | grep -E '^src/.*\.njk$' || true)
  [ -n "$hit" ] && touched="$touched$hit
"
done

if [ -z "$touched" ]; then
  echo "[pre-push] no src/**/*.njk changes — skipping the prepush gate"
  exit 0
fi

echo "[pre-push] content changes detected:"
echo "$touched" | sed '/^$/d' | head -20 | sed 's/^/           /'
echo
if [ -f "$ROOT/scripts/build-images.js" ]; then
  echo "[pre-push] checking cover image variants..."
  node "$ROOT/scripts/build-images.js" --check --match=cover-
  cover_status=$?
  if [ "$cover_status" -ne 0 ]; then
    echo "[pre-push] BLOCKED — cover variants are missing or stale."
    echo "[pre-push] Run: node scripts/build-images.js --apply --only=cover-{lang}/<slug>"
    exit "$cover_status"
  fi
else
  echo "[pre-push] build-images.js not present — skipping cover variant check (local-only tool)"
fi

echo "[pre-push] running the prepush gate (npm run prepush) — Cloudflare cannot run it."
echo

npm run prepush
status=$?

if [ "$status" -ne 0 ]; then
  echo
  echo "[pre-push] BLOCKED — the prepush gate failed (exit $status)."
  echo "[pre-push] Fix the findings above. To bypass: git push --no-verify"
fi
exit "$status"
