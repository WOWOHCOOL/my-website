#!/bin/sh
# pre-push — run the metadata gate before content changes leave the machine.
#
# WHY THIS EXISTS (2026-09-28)
# `prebuild_gate.py` is step 1 of `npm run build`, but Cloudflare Pages never
# checks out `../seomachine`, so the DEPLOY build skips it (see scripts/gate.js).
# The only machine that can run the gate is this one. Before this hook there was
# nothing that guaranteed it ran at all: no CI, and .git/hooks/pre-commit only
# runs lint-i18n-paths.js. "Local gate not run" literally meant "no gate".
#
# SCOPE: only fires when the push touches `src/**/*.njk`. Tooling-only or
# docs-only pushes are not slowed down.
#
# INSTALL (this file is the source of truth; hooks themselves are not versioned):
#     cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# REMOVE:
#     rm .git/hooks/pre-push
# BYPASS (please don't):
#     git push --no-verify

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  echo "[pre-push] not inside a git repo — skipping content gates"
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
touched=""
ref_count=0
base=""
local_sha=""

while read -r _local_ref local_sha_in _remote_ref remote_sha; do
  [ -z "${local_sha_in:-}" ] && continue
  ref_count=$((ref_count + 1))
  if [ "$remote_sha" = "$ZERO" ]; then
    base_in="origin/main"
  else
    base_in="$remote_sha"
  fi
  hit=$(git diff --name-only "$base_in..$local_sha_in" 2>/dev/null | grep -E '^src/.*\.njk$' || true)
  [ -n "$hit" ] && touched="$touched$hit
"
  # Keep the LAST ref's context for the profile diff below. Only meaningful when
  # exactly one ref is pushed; ref_count gates that (see AmbigBase below).
  base="$base_in"
  local_sha="$local_sha_in"
done

if [ -z "$touched" ]; then
  echo "[pre-push] no src/**/*.njk changes — skipping the metadata gate"
  exit 0
fi

# The per-file profile decision diffs $base..$local_sha. Those variables only
# describe ONE ref, so a push carrying several refs would classify every blog
# file against the wrong range and could wrongly downgrade a new article to the
# maintenance profile. When the ref context is not unique, force the strict
# profile — "unclear" must resolve to the stricter gate, never the looser one.
AMBIG_BASE=""
[ "$ref_count" -ne 1 ] && AMBIG_BASE="1"
[ -z "$base" ] && AMBIG_BASE="1"

echo "[pre-push] content changes detected:"
echo "$touched" | sed '/^$/d' | head -20 | sed 's/^/           /'

blog_touched=$(printf '%s\n' "$touched" | grep -E '^src/([^/]+/)?blog/.*/index\.njk$' | sed '/^$/d' || true)
if [ -n "$blog_touched" ]; then
  B2B_ROOT="${SEOMACHINE_ROOT:-$ROOT/../seomachine}"
  B2B_CHECKER="$B2B_ROOT/extensions/blog_b2b/modules/check_new_article.py"
  PY="${PYTHON:-python}"

  if [ ! -f "$B2B_CHECKER" ]; then
    echo "[pre-push] BLOCKED — B2B checker not found: $B2B_CHECKER"
    echo "[pre-push] Set SEOMACHINE_ROOT or restore the B2B extension before pushing blog changes."
    exit 1
  fi
  if ! command -v "$PY" >/dev/null 2>&1; then
    echo "[pre-push] BLOCKED — python not found ($PY); B2B blog gate cannot run."
    exit 1
  fi

  # ── Profile selection (2026-10-05) ────────────────────────────────────────
  # Two profile: a NEW article is graded on absolute quality, a MAINTENANCE
  # edit is graded on "did you make it worse". Pick per file; default to the
  # strict profile whenever the shape of the edit is unclear.
  #
  #   new file                                  -> --new-article-target
  #   added/removed <h2>, or an identity field  -> --new-article-target
  #     (title / description / canonical / h1 / <lang>Path) changed
  #   otherwise                                 -> --maintenance-gate --base $base
  #
  # The maintenance profile itself re-checks the identity freeze and the H2
  # outline against $base, so a misclassification is caught rather than passed.
  echo "[pre-push] B2B gate profile per file:"
  echo "$blog_touched" | sed '/^$/d' | head -20 | sed 's/^/           /'
  echo
  while IFS= read -r file; do
    [ -z "$file" ] && continue

    profile="--new-article-target"
    why="default (strict)"

    if [ -n "$AMBIG_BASE" ]; then
      why="ref context ambiguous (multi-ref push) -> strict"
    elif [ "$base" != "$ZERO" ] && git cat-file -e "$base:${file}" 2>/dev/null; then
      changed=$(git diff --unified=0 "$base..$local_sha" -- "$file" 2>/dev/null | grep -E '^[+-]' | grep -vE '^(\+\+\+|---)')
      # H2 additions/removals
      h2=$(printf '%s\n' "$changed" | grep -cE '^[+-][^+-]*<h2[ >]' || true)
      # identity fields
      ident=$(printf '%s\n' "$changed" | grep -cE '^[+-](title|description|canonical|h1|[a-z]{2}Path):' || true)
      if [ "$h2" -eq 0 ] && [ "$ident" -eq 0 ]; then
        profile="--maintenance-gate"
        why="maintenance (no H2 or identity change vs $(echo "$base" | cut -c1-8))"
      elif [ "$h2" -gt 0 ]; then
        why="H2 changed -> strict"
      else
        why="identity field changed -> strict"
      fi
    else
      why="new file -> strict"
    fi

    echo "[pre-push] B2B gate -> $file   [$profile : $why]"
    PYTHONUTF8=1 "$PY" "$B2B_CHECKER" $profile --base "$base" "$ROOT/$file"
    b2b_status=$?
    if [ "$b2b_status" -ne 0 ]; then
      echo
      echo "[pre-push] BLOCKED — B2B gate failed for $file (exit $b2b_status)."
      echo "[pre-push] If this was a maintenance edit that changed an <h2> or an"
      echo "[pre-push] identity field (title/description/canonical/h1/langPath), it must"
      echo "[pre-push] clear the strict profile: $PY $B2B_CHECKER --new-article-target $ROOT/$file"
      echo "[pre-push] To bypass entirely: git push --no-verify"
      exit "$b2b_status"
    fi
  done <<EOF2
$blog_touched
EOF2
fi

echo "[pre-push] running the prepush gate (npm run prepush) — Cloudflare cannot run it."
echo

npm run prepush
status=$?

if [ "$status" -ne 0 ]; then
  echo
  echo "[pre-push] BLOCKED — the metadata gate failed (exit $status)."
  echo "[pre-push] Fix the findings above. To bypass: git push --no-verify"
fi
exit "$status"
