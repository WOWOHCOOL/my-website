#!/bin/sh
# pre-push — run the metadata gate before content changes leave the machine.
#
# WHY THIS EXISTS (2026-09-28)
# `prebuild_gate.py` is step 1 of `npm run build`, but Cloudflare Pages never
# checks out `../seomachine`, so the DEPLOY build skips it (see scripts/gate.js).
# The only machine that can run the gate is this one. Before this hook there was
# nothing that guaranteed it ran at all: no CI, and .git/hooks/pre-commit only
# runs lint-i18n-paths.js. "Local gate not run" literally meant "no gate".
#
# SCOPE: only fires when the push touches `src/**/*.njk`. Tooling-only or
# docs-only pushes are not slowed down.
#
# INSTALL (this file is the source of truth; hooks themselves are not versioned):
#     cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# REMOVE:
#     rm .git/hooks/pre-push
# BYPASS (please don't):
#     git push --no-verify

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  echo "[pre-push] not inside a git repo — skipping content gates"
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
touched=""

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    base="origin/main"
  else
    base="$remote_sha"
  fi
  hit=$(git diff --name-only "$base..$local_sha" 2>/dev/null | grep -E '^src/.*\.njk$' || true)
  [ -n "$hit" ] && touched="$touched$hit
"
done

if [ -z "$touched" ]; then
  echo "[pre-push] no src/**/*.njk changes — skipping the metadata gate"
  exit 0
fi

echo "[pre-push] content changes detected:"
echo "$touched" | sed '/^$/d' | head -20 | sed 's/^/           /'

blog_touched=$(printf '%s\n' "$touched" | grep -E '^src/([^/]+/)?blog/.*/index\.njk$' | sed '/^$/d' || true)
if [ -n "$blog_touched" ]; then
  B2B_ROOT="${SEOMACHINE_ROOT:-$ROOT/../seomachine}"
  B2B_CHECKER="$B2B_ROOT/extensions/blog_b2b/modules/check_new_article.py"
  PY="${PYTHON:-python}"

  if [ ! -f "$B2B_CHECKER" ]; then
    echo "[pre-push] BLOCKED — B2B checker not found: $B2B_CHECKER"
    echo "[pre-push] Set SEOMACHINE_ROOT or restore the B2B extension before pushing blog changes."
    exit 1
  fi
  if ! command -v "$PY" >/dev/null 2>&1; then
    echo "[pre-push] BLOCKED — python not found ($PY); B2B blog gate cannot run."
    exit 1
  fi

  echo "[pre-push] running B2B new-article gate for changed blog files:"
  echo "$blog_touched" | sed '/^$/d' | head -20 | sed 's/^/           /'
  echo
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    echo "[pre-push] B2B gate -> $file"
    PYTHONUTF8=1 "$PY" "$B2B_CHECKER" --new-article-target "$ROOT/$file"
    b2b_status=$?
    if [ "$b2b_status" -ne 0 ]; then
      echo
      echo "[pre-push] BLOCKED — B2B gate failed for $file (exit $b2b_status)."
      echo "[pre-push] Fix the findings above. To bypass: git push --no-verify"
      exit "$b2b_status"
    fi
  done <<EOF2
$blog_touched
EOF2
fi

echo "[pre-push] running the prepush gate (npm run prepush) — Cloudflare cannot run it."
echo

npm run prepush
status=$?

if [ "$status" -ne 0 ]; then
  echo
  echo "[pre-push] BLOCKED — the metadata gate failed (exit $status)."
  echo "[pre-push] Fix the findings above. To bypass: git push --no-verify"
fi
exit "$status"
